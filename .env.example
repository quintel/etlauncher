# etlauncher local development environment.
# Copy to `.env` (git-ignored). All values here are DEV-ONLY and safe to commit.
#
#   cp .env.example .env
#
# --- Database (MySQL 8) ------------------------------------------------------
DB_ROOT_PASSWORD=dev

# --- Cross-service hostnames -------------------------------------------------
# Why <service>.local.energytransitionmodel.com (not localhost): the shared etm_session
# cookie needs a shared dotted PARENT domain — browsers reject a Domain cookie on the
# single-label `localhost`. The `local.` prefix keeps it off the real production domain.
# Each name resolves to loopback via /etc/hosts (browser) AND is a Docker alias
# (containers), so one identical URL works both sides — which OIDC requires.
#
# Add to /etc/hosts:
#   127.0.0.1  myetm.local.energytransitionmodel.com etmodel.local.energytransitionmodel.com etengine.local.energytransitionmodel.com collections.local.energytransitionmodel.com
ETENGINE_URL=http://etengine.local.energytransitionmodel.com:3000
ETMODEL_URL=http://etmodel.local.energytransitionmodel.com:3001
MYETM_URL=http://myetm.local.energytransitionmodel.com:3002
COLLECTIONS_URL=http://collections.local.energytransitionmodel.com:3005

# Shared parent domain for the local hostnames (must be dotted):
#   - SSO_COOKIE_DOMAIN scopes the shared etm_session cookie (MyETM writes it).
#   - ETM_HOST_PARENT is added to each app's Host Authorization (config.hosts).
SSO_COOKIE_DOMAIN=.local.energytransitionmodel.com
ETM_HOST_PARENT=.local.energytransitionmodel.com

# --- Fixed dev OAuth clients (seeded into MyETM by bin/seed-oauth) ------------
# These are deterministic so a clean `bin/up` yields working SSO with no manual
# MyETM clicks. Each app is configured with the matching id/secret below.
ETMODEL_CLIENT_ID=etm-local-etmodel-client
ETMODEL_CLIENT_SECRET=etm-local-etmodel-secret-000000000000
ETENGINE_CLIENT_ID=etm-local-etengine-client
ETENGINE_CLIENT_SECRET=etm-local-etengine-secret-00000000000
# Collections (multi-year-charts) no longer registers an OAuth client: it dropped
# next-auth and now authenticates purely via the shared etm_session cookie, verifying
# it against MyETM's JWKS in /api/me.

# --- Seeded MyETM logins (created by bin/seed-users; see CREDENTIALS.md) ------
# Dev-only, fixed so they are always the same. Passwords must be >= 6 chars.
ADMIN_EMAIL=admin@etm.local
ADMIN_PASSWORD=etm-admin
USER_EMAIL=user@etm.local
USER_PASSWORD=etm-user

# --- Collections prod-image build (COLLECTIONS_PROD=1; see compose.collections-prod.yaml) ---
# Sentry sourcemap upload token for the image build. Leave empty locally (upload is
# skipped); real uploads happen in CI.
SENTRY_AUTH_TOKEN=
