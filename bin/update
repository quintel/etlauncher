#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Pick up changes after pulling the app repos: relock Gemfiles and recreate services
# (gems/yarn deps install at container boot, so no image rebuild day to day). Pass
# --build only for Dockerfile / system-package changes.

export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

# Compose overlays — keep in sync with bin/up.
COMPOSE_FILE="compose.yaml"
if [ -n "${DEV_GEMS:-}" ]; then
  COMPOSE_FILE="${COMPOSE_FILE}:compose.gems.yaml"
fi
# COLLECTIONS_PROD=1 ./bin/update --build rebuilds Collections' production image.
if [ -n "${COLLECTIONS_PROD:-}" ]; then
  COMPOSE_FILE="${COMPOSE_FILE}:compose.collections-prod.yaml"
fi
export COMPOSE_FILE

# Report disk usage, then clean up ETLauncher's own leftovers only — this runs on every
# pull, so a machine-wide prune here would repeatedly wipe other projects' build cache.
source ./bin/lib-docker.sh
report_docker_usage
prune_etlauncher_resources

BUILD=0
[ "${1:-}" = "--build" ] && BUILD=1

source ./bin/lib-relock.sh
relock_all

if [ "$BUILD" -eq 1 ]; then
  echo "→ Rebuilding images (--build)..."
  docker compose build etengine etmodel my-etm collections
fi

# Apply any pending migrations pulled in with the new code.
echo "→ Applying pending migrations..."
failed_migrations=""
for app in my-etm etengine etmodel; do
  docker compose run --rm -e SKIP_TEST_DATABASE=1 -e SKIP_SCENARIO_CHECK \
    "$app" app-boot.sh bundle exec rails db:prepare ||
      failed_migrations="$failed_migrations $app"
done

# Force-recreate the app containers so app-boot.sh re-runs. A pulled gem ref / Gemfile.lock
# or package.json bump lives in the bind-mounted code, not the compose spec.
echo "→ Recreating app services (gems/yarn deps install on boot)..."
docker compose up -d --force-recreate etengine etmodel my-etm collections

echo "→ Ensuring remaining services are up..."
docker compose up -d

if [ -n "$failed_migrations" ]; then
  echo "✗ Stack updated, but db:prepare failed for:$failed_migrations" >&2
  exit 1
fi

echo "✓ Stack updated."
